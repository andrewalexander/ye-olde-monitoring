# Local compose only. Mirrors deploy/Caddyfile.example, plus the admin and
# explorer listeners, so the test page can show recent hits.
{
	admin off
	auto_https off
}

:80 {
	log {
		output file /var/log/caddy/access.log {
			mode 644 # the dnscount container runs as a different uid
		}
		format json
	}

	handle /counter.* {
		reverse_proxy dnscount:8080
	}

	@dnscount_ingest {
		path /ingest
		remote_ip private_ranges
	}
	handle @dnscount_ingest {
		reverse_proxy dnscount:8080
	}

	handle {
		root * /srv
		file_server
	}
}

# Breaker stats, published to the host on 127.0.0.1:8081 only (docker-compose.yml).
# Never add these to a public Caddyfile: neither has auth.
:8081 {
	reverse_proxy dnscount:8081
}

# The explorer: its API feeds the test page's recent-hits table.
:8090 {
	header Access-Control-Allow-Origin "http://localhost:8000"
	reverse_proxy explore:8090
}
