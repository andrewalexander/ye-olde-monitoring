# Local compose only. Mirrors deploy/Caddyfile.example, plus the admin and
# explorer listeners, so the test page can show recent hits, and a second
# site (examples/caddy-site) built the way a real static site is.
{
	admin off
	auto_https off
}

:80 {
	log {
		output file /var/log/caddy/access.log {
			mode 644 # the dnscount container runs as a different uid
		}
		format json
	}

	handle /counter.* {
		reverse_proxy dnscount:8080
	}

	@dnscount_ingest {
		path /ingest
		remote_ip private_ranges
	}
	handle @dnscount_ingest {
		reverse_proxy dnscount:8080
	}

	handle {
		root * /srv
		file_server
	}
}

# examples/caddy-site on localhost:8002: static files, Caddy's log is the only
# record of visits, and the counter is computed from it. In production the
# log names the site by its Host (example.com). Here both sites are
# "localhost", so this one's log entries are renamed to $CADDY_SITE_NAME
# ("caddy-site" unless docker-compose.yml is given another; the files come
# from $CADDY_SITE_DIR).
:81 {
	log {
		output file /var/log/caddy/access.log {
			mode 644
		}
		format filter {
			request>host replace {$CADDY_SITE_NAME}
			wrap json
		}
	}

	# Local previews swap which folder this serves (CADDY_SITE_DIR), so make
	# browsers recheck every time instead of showing a cached copy.
	header Cache-Control no-cache

	handle /counter.* {
		reverse_proxy dnscount:8080
	}

	handle {
		root * /srv-caddy-site
		try_files {path} {path}.html
		file_server
	}

	handle_errors 404 {
		root * /srv-caddy-site
		@page file /404.html
		rewrite @page /404.html
		file_server
	}
}

# Breaker stats, published to the host on 127.0.0.1:8081 only (docker-compose.yml).
# Never add these to a public Caddyfile: neither has auth.
:8081 {
	reverse_proxy dnscount:8081
}

# The explorer: its API feeds the test page's recent-hits table.
:8090 {
	header Access-Control-Allow-Origin "http://localhost:8000"
	reverse_proxy explore:8090
}
