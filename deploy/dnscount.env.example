# /etc/dnscount/dnscount.env (root:dnscount, mode 0640). install.sh creates
# it on first install with a random token, and never overwrites it after that.

DNSCOUNT_DB=/var/lib/dnscount/dnscount.db

# Bearer token for POST /ingest. Put the same value in each RemoteSink.
DNSCOUNT_TOKEN=change-me

# Caddy on the same box proxies to localhost, so only localhost is a trusted
# proxy. If Caddy runs on another host, set -addr to this host's LAN IP and
# -trusted-proxies to Caddy's IP. -counter-sites: the sites /counter.svg
# answers for (computed from their hits, so their Caddy vhost must log).
DNSCOUNT_SERVE_FLAGS=-addr 127.0.0.1:8080 -admin-addr 127.0.0.1:8081 -trusted-proxies 127.0.0.1/32,::1/128 -counter-sites example.com

# Caddy JSON access log for dnscount-caddy-log.service.
DNSCOUNT_CADDY_LOG=/var/log/caddy/access.log

# Router syslog receiver (dnscount-syslog.service). Leave unset to not run it.
# -allow is required: only these source IPs are accepted. Open the port in the
# host firewall for the router only. -raw keeps every line for re-ingesting.
#DNSCOUNT_SYSLOG_FLAGS=-listen udp://192.168.1.10:5514 -allow 192.168.1.1 -raw /var/lib/dnscount/raw
