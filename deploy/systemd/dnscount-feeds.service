[Unit]
Description=dnscount: download threat feeds and the IP-to-ASN table
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=dnscount
Group=dnscount
EnvironmentFile=/etc/dnscount/dnscount.env
ExecStart=/usr/local/bin/dnscount feeds update
StateDirectory=dnscount
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Nice=10
IOSchedulingClass=idle
